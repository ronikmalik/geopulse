# Copy to .env.local for local development. Every variable actually read by
# the app is listed here — see the grep-for-process.env note in
# docs/ARCHITECTURE.md if this ever drifts out of sync with the code.

# Required. Postgres connection string (this project uses Neon).
# Get one free at https://neon.tech — Storage tab on the Vercel project if
# deployed there, or a standalone Neon project otherwise.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. If set, /api/ingest requires "Authorization: Bearer <value>" —
# leave unset for local dev (the route allows unauthenticated calls when no
# secret is configured) and set it in production if you want to stop
# strangers from triggering ingestion runs directly.
CRON_SECRET=

# Optional. Only needed for the country-snapshot stock-index lookup
# (src/lib/sources/finnhub.ts). Free tier key from https://finnhub.io —
# without it, index quotes are silently omitted rather than erroring.
FINNHUB_API_KEY=

# Optional. Satellite thermal-anomaly detection (src/lib/sources/firms.ts) —
# free instant-signup key from https://firms.modaps.eosdis.nasa.gov/api/map_key/.
# Without it, this source silently no-ops rather than erroring.
FIRMS_MAP_KEY=

# Optional. Powers event embeddings (src/lib/embeddings.ts, "similar
# events" on the feed) and daily AI country briefs
# (src/lib/countryBriefs.ts). Free API key from
# https://aistudio.google.com/apikey — as long as no billing account is
# linked to that Google Cloud project, this cannot incur any charge;
# exceeding the free tier just returns a 429, which this app already
# treats as a soft failure and retries next cycle. Without it, both
# features silently no-op.
GEMINI_API_KEY=

# Optional overrides for the exact Gemini model ids — see the comment in
# src/lib/embeddings.ts for why these are configurable rather than
# hardcoded (genuine naming uncertainty as of 2026-09-08). Leave unset to
# use the defaults; if calls start 404ing, hit GET /api/admin/ai-models
# (with CRON_SECRET) to see Google's actual current model list and set
# these to match — no redeploy needed to fix, just an env var change.
GEMINI_EMBED_MODEL=
GEMINI_BRIEF_MODEL=
GEMINI_AUDIT_MODEL=
